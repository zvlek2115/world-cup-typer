// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  FINISHED
}

model User {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  passwordHash          String
  role                  Role                   @default(USER)
  predictions           Prediction[]
  groupPredictions      GroupPrediction[]
  individualPredictions IndividualPrediction[]
}

model Match {
  id          String       @id @default(uuid())
  homeTeam    String
  awayTeam    String
  startTime   DateTime
  homeScore   Int?
  awayScore   Int?
  status      MatchStatus  @default(SCHEDULED)
  predictions Prediction[]
}

model Prediction {
  id                 String @id @default(uuid())
  userId             String
  matchId            String
  predictedHomeScore Int
  predictedAwayScore Int
  pointsEarned       Int?

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model Team {
  id         String @id @default(uuid())
  name       String @unique
  groupName  String // e.g., "A", "B", ..., "L"
  actualRank Int?   // 1, 2, 3, or 4 (set by admin when group is finished)
}

model GroupPrediction {
  id            String @id @default(uuid())
  userId        String
  groupName     String
  teamName      String
  predictedRank Int    // 1, 2, 3, or 4
  pointsEarned  Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, groupName, teamName])
}

model IndividualPrediction {
  id              String  @id @default(uuid())
  userId          String  @unique
  winner          String?
  mvp             String?
  topScorer       String?
  winnerPoints    Int?
  mvpPoints       Int?
  topScorerPoints Int?

  user User @relation(fields: [userId], references: [id])
}
